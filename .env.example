# ---------------------------------------------------------------
# Everything below is OPTIONAL.
#
# With no .env at all the app still runs end to end:
#   • auth falls back to a local browser session
#   • cases are held in memory for the life of the dev server
#
# Fill these in to switch on real auth and real persistence. No code
# changes are needed — the app detects the keys at boot.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → Database → Connection string → URI
# (or any Postgres instance)
DATABASE_URL=
